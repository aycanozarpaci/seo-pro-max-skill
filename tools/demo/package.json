{
  "name": "seo-pro-max-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Remotion-rendered demo GIF for the seo-pro-max README.",
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:mp4": "remotion render src/index.ts SeoProMaxDemo out/demo.mp4",
    "render:gif": "remotion render src/index.ts SeoProMaxDemo out/demo.gif --codec=gif --width=800",
    "render:all": "npm run render:mp4 && npm run render:gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.260",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.260"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
